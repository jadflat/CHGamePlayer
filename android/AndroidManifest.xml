<?xml version="1.0" encoding="utf-8"?>
<!-- CHGame Player: one permission, the internet, for Get games (the catalogue's downloads).
     Games and .DAT files come from one folder the user picks with Android's own picker
     (a document tree). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jadflat.chgame"
    android:versionCode="45"
    android:versionName="0.45">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:extractNativeLibs="false"
        android:hasFragileUserData="false"
        android:isGame="true"
        android:appCategory="game">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Dark"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:screenOrientation="fullSensor"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ES-DE and other front ends: ACTION_VIEW with a content:// URI to one .CHG,
             readable for that launch only. Nothing else is accepted (LaunchActivity checks) -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OptionsActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".CatalogueActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".TouchSettingsActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".TouchEditorActivity"
            android:exported="false"
            android:theme="@style/DarkFull" />

        <activity
            android:name=".MediaActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".SavesActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".DuplicatesActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".MapButtonsActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".GameSettingsActivity"
            android:exported="false"
            android:theme="@style/Dark" />

        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:theme="@style/DarkFull"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation"
            android:screenOrientation="fullSensor" />
    </application>
</manifest>
